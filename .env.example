# Server-only — set in Vercel project settings for live Helpbot / SI summaries
GEMINI_API_KEY=

# Phase 1 CAD convert (/api/cad-convert) — optional
# When set, clients must send Authorization: Bearer <token>
CAD_CONVERT_TOKEN=
# External DWG→DXF service (same JSON contract: { fileName, contentBase64 } → { dxf })
CAD_CONVERT_UPSTREAM=
CAD_CONVERT_UPSTREAM_TOKEN=
# Max convert requests per client IP per minute (default 20)
CAD_CONVERT_RATE_MAX=20
