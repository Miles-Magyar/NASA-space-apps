# Server-only — set all three in Vercel project settings for live Helpbot
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phase 1 CAD convert (/api/cad-convert) — optional
# When set, clients must send Authorization: Bearer <token>
CAD_CONVERT_TOKEN=
# External DWG→DXF service (same JSON contract: { fileName, contentBase64 } → { dxf })
# Local: npm run cad-convert:upstream  →  http://127.0.0.1:8787/convert
CAD_CONVERT_UPSTREAM=
CAD_CONVERT_UPSTREAM_TOKEN=
# Optional CLI for the upstream worker (LibreDWG dwg2dxf or ODA converter)
CAD_CONVERT_BIN=
# Max convert requests per client IP per minute (default 20)
CAD_CONVERT_RATE_MAX=20
